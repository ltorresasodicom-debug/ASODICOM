# =============================================================================
# SIGEL — Variables de entorno (copia a .env y ajusta)
# =============================================================================

# -- Base de datos --
DB_HOST=postgres
DB_PORT=5432
DB_USER=sigel
DB_PASSWORD=sigel
DB_NAME=sigel

# -- Redis --
REDIS_HOST=redis
REDIS_PORT=6379

# -- Mongo --
MONGO_URI=mongodb://sigel:sigel@mongo:27017/sigel

# -- Gateway (NestJS) --
GATEWAY_PORT=3000
JWT_SECRET=CHANGE-ME-IN-PRODUCTION-AT-LEAST-32-CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth2 (Google) — opcional
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# -- Analytics / AI --
ANALYTICS_URL=http://analytics:8000
AI_URL=http://ai:8001

# -- AWS (producción) --
AWS_REGION=us-east-1
S3_BUCKET=sigel-storage

# -- Frontend --
NEXT_PUBLIC_API_BASE=http://localhost:3000/api/v1

# -- Observabilidad --
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
